# Example environment variables for running the application with Docker Compose.
# Copy this file to .env and edit the values there (.env is not tracked by git):
#   cp .env.example .env
#
# these variables only run when launching a container, after the image is built.

# change this variable to import projects from a different location
PROJECT_DIRECTORY=./inst/extdata/projects

# change this variable to specify a different application mode
# available options are: "project", "beginner", "advanced"
R_CONFIG_ACTIVE=project

# change to this variable to specify if
# true: the default projects distributed with the application should be used
# false: the projects located in PROJECT_DIRECTORY should be used
FORCE_DEFAULT_PROJECTS=true

# gurobi license absolute file path. Can not be called GRB_LICENSE_FILE.
PATH_TO_GUROBI_LICENSE=/path/to/gurobi.lic

# CARTO API key for the "Gray scale" and "Monochrome" basemaps. Leave blank
# to still show these basemaps, but with an "API key required" watermark.
CARTO_API_KEY=
